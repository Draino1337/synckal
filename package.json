{
  "name": "synckal",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "description": "Смотрите YouTube с друзьями синхронно: комнаты, общий плейлист, чат.",
  "scripts": {
    "dev": "concurrently -k -n srv,web -c magenta,cyan \"node --watch server/index.mjs --dev\" \"vite --port 5173 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
